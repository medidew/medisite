{{define "content"}}
<h1>Blog</h1>

{{template "search_form" .}}

{{if .Query}}
  {{if .Results}}
  <p class="meta">{{len .Results}} result{{if ne (len .Results) 1}}s{{end}} for &ldquo;{{.Query}}&rdquo;</p>
  <ul class="post-list post-list--full">
    {{range .Results}}
    <li>
      <a class="post-title" href="/blog/{{.Slug}}">{{.Title}}</a>
      <div class="meta">{{.Date.Format "Jan 2, 2006"}}</div>
      {{if .Summary}}<p class="summary">{{.Summary}}</p>{{end}}
    </li>
    {{end}}
  </ul>
  {{else}}
  <p>No posts found for &ldquo;{{.Query}}&rdquo;.</p>
  {{end}}
{{else}}
<p>Enter a search term above to look through post titles, summaries, tags, and body text.</p>
{{end}}
{{end}}
