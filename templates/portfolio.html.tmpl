{{define "content"}}
<p>
Due to University academic policy, copies of my academic projects are not allowed to be shared publicly. This portfolio consists of personal projects only.
</p>
<h1>Portfolio</h1>

{{if .Projects}}
<ul class="project-list">
  {{range .Projects}}
  <li>
    <a class="project-title" href="{{.Link}}">{{.Title}}</a>
    <p>{{.Description}}</p>
    {{if .Tags}}<p class="meta">{{range $i, $t := .Tags}}{{if $i}}, {{end}}{{$t}}{{end}}</p>{{end}}
  </li>
  {{end}}
</ul>
{{else}}
<p>Nothing listed yet &mdash; check back soon.</p>
{{end}}
{{end}}
