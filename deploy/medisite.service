# systemd unit for medisite (medidew.name), reverse-proxied by nginx.
#
# Install and redeploy: sudo ./deploy/install.sh
#   Builds the binary, creates the "medisite" system user and /opt/medisite
#   if needed, installs this unit, and (re)starts the service. Safe to
#   re-run after any code, config, template, or static change — see that
#   script's header for exactly what it does and does not touch (notably,
#   it never overwrites content/ once it exists, so posts and portfolio
#   entries edited directly on the server are never clobbered by a
#   redeploy).
#
# Logs: journalctl -u medisite -f, and /opt/medisite/medisite.log (the
# log_file path from config.yaml), which the service account needs write
# access to — covered by ReadWritePaths below.

[Unit]
Description=medisite web server (medidew.name)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=medisite
Group=medisite
WorkingDirectory=/opt/medisite
ExecStart=/opt/medisite/medisite -config /opt/medisite/config.yaml
Restart=on-failure
RestartSec=5

# Sandboxing. medisite listens on 127.0.0.1 (an unprivileged port) and
# only needs to read its working directory and write its log file there,
# so no elevated capabilities or broad filesystem access are required.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/medisite
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
